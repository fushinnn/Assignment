<Window x:Class="MovieLibrary.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Movie Library" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- TOP SECTION: Add Movie -->
        <GroupBox Header="Add Movie" DockPanel.Dock="Top" Margin="8" Height="80">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="ID"       Grid.Column="0" Grid.Row="0" Margin="4,4,4,0" FontWeight="Bold"/>
                <TextBlock Text="Title"    Grid.Column="1" Grid.Row="0" Margin="4,4,4,0" FontWeight="Bold"/>
                <TextBlock Text="Director" Grid.Column="2" Grid.Row="0" Margin="4,4,4,0" FontWeight="Bold"/>
                <TextBlock Text="Genre"    Grid.Column="3" Grid.Row="0" Margin="4,4,4,0" FontWeight="Bold"/>
                <TextBlock Text="Year"     Grid.Column="4" Grid.Row="0" Margin="4,4,4,0" FontWeight="Bold"/>

                <TextBox x:Name="TxtId"       Grid.Column="0" Grid.Row="1" PreviewTextInput="txtbox_check_Int_Input" Margin="4,4,4,4"/>
                <TextBox x:Name="TxtTitle"    Grid.Column="1" Grid.Row="1" Margin="4,4,4,4"/>
                <TextBox x:Name="TxtDirector" Grid.Column="2" Grid.Row="1" Margin="4,4,4,4"/>
                <TextBox x:Name="TxtGenre"    Grid.Column="3" Grid.Row="1" Margin="4,4,4,4"/>
                <TextBox x:Name="TxtYear"     Grid.Column="4" Grid.Row="1" PreviewTextInput="txtbox_check_Int_Input" Margin="4,4,4,4"/>
                <Button  x:Name="BtnAdd"      Grid.Column="5" Grid.Row="1" Content="Add Movie" Click="BtnAdd_Click"/>
            </Grid>
        </GroupBox>

        <!-- BOTTOM SECTION: Status bar -->
        <StatusBar DockPanel.Dock="Bottom" Height="25">
            <TextBlock x:Name="TxtStatus" Text="Ready"/>
        </StatusBar>

        <!-- LEFT SECTION: Actionable buttons etc -->
        <StackPanel DockPanel.Dock="Left" Width="165" Margin="8">

            <TextBlock Text="Search" FontWeight="Bold" Margin="4,8,4,2"/>
            <TextBox x:Name="TxtSearch"/>
            <Button Content="Search by Title" Click="BtnSearchTitle_Click"/>
            <Button Content="Search by ID"    Click="BtnSearchId_Click"/>

            <TextBlock Text="Sort" FontWeight="Bold" Margin="4,12,4,2"/>
            <Button Content="Bubble Sort (Title)" Click="BtnBubbleSort_Click"/>
            <Button Content="Merge Sort (Year)"   Click="BtnMergeSort_Click"/>
            <Button Content="Show All"            Click="BtnShowAll_Click"/>

            <TextBlock Text="Borrow / Return" FontWeight="Bold" Margin="4,12,4,2"/>
            <TextBox x:Name="TxtUsername" ToolTip="Username"/>
            <Button Content="Borrow Movie" Click="BtnBorrow_Click"/>
            <Button Content="Return Movie" Click="BtnReturn_Click"/>
            <Button Content="Remove Movie" Click="BtnRemove_Click"/>

        </StackPanel>

        <!-- CENTRE / RIGHT SECTION: Movie Navigation -->
        <DataGrid x:Name="MovieGrid"
                  Margin="8"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal" Width="700" SelectionChanged="MovieGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"           Binding="{Binding MovieId}"     Width="80"/>
                <DataGridTextColumn Header="Title"        Binding="{Binding Title}"        Width="*"/>
                <DataGridTextColumn Header="Director"     Binding="{Binding Director}"     Width="120"/>
                <DataGridTextColumn Header="Genre"        Binding="{Binding Genre}"        Width="80"/>
                <DataGridTextColumn Header="Year"         Binding="{Binding ReleaseYear}"  Width="50"/>
                <DataGridTextColumn Header="Availability" Binding="{Binding Availability}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</Window>